# Copy to .env next to compose.yaml

# Match your host user (run `id`)
PUID=1000
PGID=1000

# Comma-separated; `docker run --rm ghcr.io/joostme/container-agent modules` lists them
AGENT_MODULES=gh,code-server,claude-remote,t3

# Upgrade tools tracked as "latest" on every start
AUTO_UPDATE=true

CODE_SERVER_PASSWORD=changeme
CLAUDE_REMOTE_NAME=my-agent
# Reverse proxy URL or LAN address for T3 pairing links (t3-pair)
T3_PUBLIC_URL=
T3_PUBLIC_HOST=

SSH_KEY_PATH=~/.ssh
GH_TOKEN=
