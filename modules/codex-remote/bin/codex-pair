#!/bin/bash
# Short-lived pairing code for Codex Remote Control: enter it in the ChatGPT
# app to control Codex in this container. Needs the running codex-remote
# daemon, which owns the control socket in ~/.codex.
#
#   docker compose exec <service> codex-pair
set -euo pipefail

# The server state lives in the agent user's ~/.codex, not root's
if [ "$(id -u)" = 0 ]; then
    exec agent-run "$0" "$@"
fi

exec codex remote-control pair "$@"
