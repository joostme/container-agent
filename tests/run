#!/bin/bash
# Tests of the entrypoint: resolving fitout.toml and the catalog, checks, and
# the generated mise and pitchfork config. They run `fitout plan`, which
# needs no root and no container.
# shellcheck disable=SC2015  # `check && pass || fail` is safe, pass never fails
set -uo pipefail
cd "$(dirname "$0")/.." || exit 1

FITOUT="${PWD}/image/fitout"
WORK=$(mktemp -d)
trap 'rm -rf "${WORK}"' EXIT
# a copy, so tests can change it
CATALOG="${WORK}/catalog"
cp -r catalog "${CATALOG}"
failures=0

pass() { echo "ok   $1"; }
fail() {
    echo "FAIL $1"
    [ -z "${2:-}" ] || while IFS= read -r line; do echo "     ${line}"; done <<< "$2"
    failures=$((failures + 1))
}

# A config folder: fitout.toml from $1 (catalog line added), modules from $2...
config() {
    local dir module
    dir=$(mktemp -d "${WORK}/config-XXXX")
    mkdir -p "${dir}/modules"
    printf 'format = 1\ncatalog = "%s"\n%s\n' "${CATALOG}" "$1" > "${dir}/fitout.toml"
    shift
    for module in "$@"; do
        printf '%s\n' "${module}" > "${dir}/modules/$(sed -n 's/^name = "\(.*\)"/\1/p' <<< "${module}").toml"
    done
    echo "${dir}"
}

# Runs plan with a config folder; extra arguments are environment variables
plan() {
    local dir=$1
    shift
    env -i PATH="${PATH}" HOME="${HOME}" FITOUT_CONFIG="${dir}" \
        FITOUT_CACHE="${dir}/cache" "$@" "${FITOUT}" plan 2>&1
}

order_of() { sed -n '/^# Modules/,/^$/p' <<< "$1" | awk 'NR > 1 && NF { print $1 }' | paste -sd' '; }

expect_order() {  # name, fitout.toml body, expected order
    local out order
    out=$(plan "$(config "$2")")
    order=$(order_of "${out}")
    [ "${order}" = "$3" ] && pass "$1" || fail "$1" "expected: $3"$'\n'"got:      ${order}"$'\n'"${out}"
}

expect_error() {  # name, pattern, config dir, env...
    local name=$1 pattern=$2 dir=$3 out
    shift 3
    if out=$(plan "${dir}" "$@"); then
        fail "${name}" "expected an error matching '${pattern}'"$'\n'"${out}"
    elif grep -q -- "${pattern}" <<< "${out}"; then
        pass "${name}"
    else
        fail "${name}" "error does not match '${pattern}'"$'\n'"${out}"
    fi
}

expect_line() {  # name, line, config dir, env...
    local name=$1 line=$2 dir=$3 out
    shift 3
    out=$(plan "${dir}" "$@")
    grep -Fxq -- "${line}" <<< "${out}" && pass "${name}" || fail "${name}" "missing line: ${line}"$'\n'"${out}"
}

# --- resolution and order -------------------------------------------------
expect_order "requires pulls in claude, git and node, before the modules that need them" \
    'modules = ["t3", "claude-remote"]' "node ssh git claude claude-remote t3"
expect_order "modules follow their names where nothing requires otherwise" \
    'modules = ["t3", "codex"]' "ssh git codex node t3"
expect_order "no modules" "" ""
expect_line "a module comes from the catalog, with its version" "gh               catalog 1.0.0" \
    "$(config 'modules = ["gh"]')"
expect_error "a module not in the catalog" "nope is not in the catalog" "$(config 'modules = ["nope"]')"
expect_error "a module name that is no name" "../gh is no module name" "$(config 'modules = ["../gh"]')"
expect_error "modules is a list" "modules is a list of module names" "$(config $'[modules]\ngh = "1.0.0"')"
sed -i 's/^format = 1$/format = 2/' "${CATALOG}/go.toml"
expect_error "a module in another format stops the start" "uses format 2" "$(config 'modules = ["go"]')"
cp catalog/go.toml "${CATALOG}/go.toml"

# --- download and cache -------------------------------------------------------
dir=$(config 'modules = ["codex"]')
plan "${dir}" > /dev/null
sed -i 's/^description = .*/description = "changed"/' "${CATALOG}/codex.toml"
plan "${dir}" > /dev/null
grep -q '^description = "changed"' "${dir}/cache/catalog/codex.toml" \
    && pass "every start takes the current catalog" || fail "every start takes the current catalog"
mv "${CATALOG}" "${WORK}/catalog-away"
expect_line "without the catalog, modules come from the cache" "codex            catalog 1.0.0" "${dir}"
expect_error "an uncached module needs the catalog" "not reachable" "$(config 'modules = ["gh"]')"
mv "${WORK}/catalog-away" "${CATALOG}"
cp catalog/codex.toml "${CATALOG}/codex.toml"

# --- local modules ----------------------------------------------------------
mine=$'format = 1\nname = "mine"\ndescription = "mine"\nrequires = ["gh"]\n[env.MINE_PORT]\ntype = "port"\nprotocol = "http"\ndefault = "9000"\n[mise.tools]\njava = "21"\n[mise.tasks.mine-hello]\nrun = "echo hello"\n[daemons.mine]\nrun = "exec sleep 1000"\n[daemons.mine-root]\nrun = "exec sleep 1000"\nuser = "root"'
dir=$(config 'modules = ["mine"]' "${mine}")
expect_line "a local module comes from modules/" "mine             local" "${dir}"
expect_line "its requires come from the catalog" "gh               catalog 1.0.0" "${dir}"
expect_line "its [mise] goes to conf.d" 'java = "21"' "${dir}"
expect_line "its tasks become commands" "mine-hello" "${dir}"
expect_line "daemons start on boot by default" "boot_start = true" "${dir}"
expect_line "daemons run in the workspace by default" 'dir = "/workspace"' "${dir}"
expect_line "root daemons run without mise by default" "mise = false" "${dir}"
gh_local=$'format = 1\nname = "gh"\ndescription = "my gh"'
expect_line "a local file replaces a catalog module" "gh               local" \
    "$(config 'modules = ["mine"]' "${mine}" "${gh_local}")"
expect_error "a module with an unknown field" "unknown field foo" \
    "$(config 'modules = ["bad"]' $'format = 1\nname = "bad"\ndescription = "x"\nfoo = 1')"
expect_error "a module with mise.env" "mise.env is not allowed" \
    "$(config 'modules = ["bad"]' $'format = 1\nname = "bad"\ndescription = "x"\n[mise.env]\nX = "1"')"
expect_error "a module with another hook" "hook pre-tools is not allowed" \
    "$(config 'modules = ["bad"]' $'format = 1\nname = "bad"\ndescription = "x"\n[mise.bootstrap.hooks.pre-tools]\nrun = "x"')"
dir=$(config 'modules = ["bad"]' $'format = 1\nname = "other"\ndescription = "x"')
mv "${dir}/modules/other.toml" "${dir}/modules/bad.toml"
expect_error "a module whose name differs from its file" "its name is other" "${dir}"
expect_error "a cycle" "requires itself" \
    "$(config 'modules = ["a"]' $'format = 1\nname = "a"\ndescription = "a"\nrequires = ["b"]' $'format = 1\nname = "b"\ndescription = "b"\nrequires = ["a"]')"
expect_error "the same task in two modules" "task t3-pair is defined by" \
    "$(config 'modules = ["t3", "dup"]' $'format = 1\nname = "dup"\ndescription = "x"\n[mise.tasks.t3-pair]\nrun = "x"')"

# --- values -----------------------------------------------------------------
expect_line "a default fills an unset variable" "T3_PORT=3773" "$(config 'modules = ["t3"]')"
expect_line "fitout.toml wins over the default" "T3_PORT=4000" "$(config $'modules = ["t3"]\n[env]\nT3_PORT = 4000')"
expect_line "the environment wins over fitout.toml" "T3_PORT=5000" \
    "$(config $'modules = ["t3"]\n[env]\nT3_PORT = 4000')" T3_PORT=5000
expect_error "a secret in fitout.toml" "OPENCODE_SERVER_PASSWORD is a secret" \
    "$(config $'modules = ["opencode"]\n[env]\nOPENCODE_SERVER_PASSWORD = "x"')"
expect_error "a required variable without value" "OPENCODE_SERVER_PASSWORD is required" \
    "$(config 'modules = ["opencode"]')"
expect_line "secrets come from the environment and stay hidden" "OPENCODE_SERVER_PASSWORD=***" \
    "$(config 'modules = ["opencode"]')" OPENCODE_SERVER_PASSWORD=s3cret
expect_line "[env] a module does not declare still reaches the container" "TZ=Europe/Berlin" \
    "$(config $'modules = ["gh"]\n[env]\nTZ = "Europe/Berlin"')"
expect_line "the user's variables reach the modules" "FITOUT_USER=fitout" "$(config "")"
expect_line "PUID defaults to 1000" "PUID=1000" "$(config "")"
expect_line "PUID comes from the environment" "PUID=1234" "$(config "")" PUID=1234

# --- fitout.toml --------------------------------------------------------------
expect_error "an unknown field in fitout.toml" "unknown field puid" "$(config 'puid = 99')"
dir=$(config "") && sed -i 's/^format = 1$/format = 2/' "${dir}/fitout.toml"
expect_error "an unknown format of fitout.toml" "fitout.toml has format 2" "${dir}"
expect_error "a missing fitout.toml" "fitout.toml not found" "${WORK}/nowhere"

# --- the example ------------------------------------------------------------------
dir=$(mktemp -d "${WORK}/example-XXXX")
cp -r example/config/. "${dir}/"
sed -i "s|^format = 1$|&\ncatalog = \"${CATALOG}\"|" "${dir}/fitout.toml"
expect_line "the example resolves" "claude-remote    catalog 1.0.0" "${dir}" CODE_SERVER_PASSWORD=x

# --- the whole catalog ----------------------------------------------------------
all=$(cd catalog && for f in *.toml; do printf '"%s", ' "${f%.toml}"; done)
dir=$(config "modules = [${all%, }]")
out=$(plan "${dir}" OPENCODE_SERVER_PASSWORD=x)
[ "$(order_of "${out}" | wc -w)" -eq "$(find catalog -name '*.toml' | wc -l)" ] \
    && pass "every catalog module resolves" || fail "every catalog module resolves" "${out}"

# pitchfork must accept the generated config with the daemons of all modules
mkdir -p "${WORK}/pf/.config/pitchfork"
sed -n '/^# \/etc\/pitchfork\/config.toml/,$p' <<< "${out}" > "${WORK}/pf/.config/pitchfork/config.toml"
daemons=$(cd "${WORK}/pf" && HOME="${WORK}/pf" pitchfork daemons 2>&1)
expected=$(yq -p toml -o yaml '.daemons | keys | .[]' "${WORK}/pf/.config/pitchfork/config.toml" | sort)
got=$(grep -oE 'global/[a-z0-9-]+' <<< "${daemons}" | sed 's|global/||' | sort -u)
[ -n "${expected}" ] && [ "${expected}" = "${got}" ] \
    && pass "pitchfork accepts the daemons of all modules" \
    || fail "pitchfork accepts the daemons of all modules" "expected: ${expected}"$'\n'"${daemons}"

# mise must accept the generated config of all modules
mkdir -p "${WORK}/mise/conf.d" "${WORK}/mise/work"
awk -v dir="${WORK}/mise/conf.d" '
    /^# \/etc\/mise\/conf.d\// { file = dir "/" substr($0, length("# /etc/mise/conf.d/") + 1); next }
    /^# \/etc\/pitchfork\// { file = "" }
    file != "" { print > file }' <<< "${out}"
tasks=$(cd "${WORK}/mise/work" && MISE_SYSTEM_CONFIG_DIR="${WORK}/mise" MISE_CONFIG_DIR="${WORK}/mise/none" \
    mise tasks ls 2>&1)
grep -q "t3-pair" <<< "${tasks}" && grep -q "codex-remote-pair" <<< "${tasks}" \
    && pass "mise reads the config of all modules" || fail "mise reads the config of all modules" "${tasks}"

# --- catalog checks ------------------------------------------------------------------
repo="${WORK}/repo"
mkdir -p "${repo}"
cp -r scripts catalog "${repo}/"
out=$(cd "${repo}" && printf '[env.TOKEN]\n[mise.tasks.t3-x]\nrun = "x"\n' >> catalog/gh.toml && scripts/check-catalog 2>&1)
grep -q "variable TOKEN does not start with GH_" <<< "${out}" && grep -q "t3-x does not start with gh-" <<< "${out}" \
    && pass "variables, tasks and daemons carry the module name" \
    || fail "variables, tasks and daemons carry the module name" "${out}"

# --- run command ------------------------------------------------------------------
out=$(env -i PATH="${PATH}" "${FITOUT}" run true 2>&1) \
    && fail "run waits for the setup" "${out}" \
    || { grep -q "setup has not finished" <<< "${out}" && pass "run waits for the setup" || fail "run waits for the setup" "${out}"; }

echo
if [ "${failures}" -gt 0 ]; then
    echo "${failures} failed"
    exit 1
fi
echo "all passed"
