{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "customManagers:dockerfileVersions"
  ],
  "customManagers": [
    {
      "description": "mise schema linked from schema/v1/module.schema.json; same dependency as in the Dockerfile, so both land in one PR",
      "customType": "regex",
      "managerFilePatterns": [
        "/^schema/v1/module\\.schema\\.json$/"
      ],
      "matchStrings": [
        "jdx/mise/v(?<currentValue>[0-9.]+)/"
      ],
      "depNameTemplate": "jdx/mise",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.+)$"
    },
    {
      "description": "pitchfork schema linked from schema/v1/module.schema.json; same dependency as in the Dockerfile, so both land in one PR",
      "customType": "regex",
      "managerFilePatterns": [
        "/^schema/v1/module\\.schema\\.json$/"
      ],
      "matchStrings": [
        "jdx/pitchfork/v(?<currentValue>[0-9.]+)/"
      ],
      "depNameTemplate": "jdx/pitchfork",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.+)$"
    }
  ]
}
