#!/bin/bash
# Runs a command as the agent user, with the mise tools and environment.
# Without a command it opens a login shell.
#
#   docker compose exec <service> agent-run [command...]
set -euo pipefail

# shellcheck source=/dev/null
. /run/container-agent/env 2>/dev/null \
    || { echo "agent-run: container-agent has not finished its setup yet" >&2; exit 1; }

if [ "$(id -u)" = 0 ]; then
    exec gosu "${PUID}:${PGID}" env \
        HOME="${AGENT_HOME}" USER="${AGENT_USER}" LOGNAME="${AGENT_USER}" SHELL=/bin/zsh \
        "$0" "$@"
fi

[ $# -gt 0 ] || set -- zsh -l
exec mise exec -- "$@"
