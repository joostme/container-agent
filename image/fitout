#!/bin/bash
# fitout: a plain container, fitted out on start. Reads the modules in
# /etc/fitout/fitout.toml, hands their tools to mise and their daemons to
# pitchfork, and sets up the user both run as.
#
#   fitout start         entrypoint, runs as root
#   fitout run [cmd...]  run a command as the user, with the mise tools and
#                        environment; without one, open a login shell
#   fitout plan          print the resolved modules and generated config
#   fitout health        healthcheck: every daemon runs
set -euo pipefail

# Module formats this engine reads
FORMATS="1"
DEFAULT_CATALOG="https://raw.githubusercontent.com/joostme/fitout/main/catalog"

FITOUT_USER=fitout
FITOUT_HOME=/home/fitout
WORKSPACE=/workspace
# Overridable for tests and `plan` outside a container
CONFIG_DIR=${FITOUT_CONFIG:-/etc/fitout}
CACHE_ROOT=${FITOUT_CACHE:-${FITOUT_HOME}/.cache/fitout}
CACHE_DIR=${CACHE_ROOT}/catalog
STATE_DIR=/run/fitout
MISE_CONF_D=/etc/mise/conf.d
PITCHFORK_CONFIG=/etc/pitchfork/config.toml
MARKER="# fitout mise setup"

declare -A FILE=() SOURCE=() MARK=() TYPE_OF=()
ENABLED=()
ORDER=()
EXPORTED_VARS=(FITOUT_USER FITOUT_HOME PUID PGID BASH_ENV)

log() { echo "[fitout] $*" >&2; }
die() { echo "[fitout] error: $*" >&2; exit 1; }

# Login shell of the user: bash, unless a module (zsh) set another
user_shell() { getent passwd "${FITOUT_USER}" | cut -d: -f7; }

as_user() {
    (cd "${FITOUT_HOME}" && gosu "${PUID}:${PGID}" env \
        HOME="${FITOUT_HOME}" USER="${FITOUT_USER}" LOGNAME="${FITOUT_USER}" SHELL="$(user_shell)" \
        "$@")
}

toml_json() { yq -p toml -o json '.' "$1"; }

# ---------------------------------------------------------------------------
# fitout.toml
# ---------------------------------------------------------------------------
read_config() {
    local file="${CONFIG_DIR}/fitout.toml" unknown format
    [ -f "${file}" ] || die "${file} not found; mount a folder with fitout.toml at ${CONFIG_DIR}"
    CONFIG=$(toml_json "${file}") || die "${file} is not valid TOML"

    format=$(jq -r '.format // empty' <<< "${CONFIG}")
    grep -qx "${format:-none}" <<< "${FORMATS// /$'\n'}" \
        || die "fitout.toml has format ${format:-none}; this image reads format ${FORMATS}"
    unknown=$(jq -r 'keys - ["format","catalog","modules","env"] | join(", ")' <<< "${CONFIG}")
    [ -z "${unknown}" ] || die "fitout.toml: unknown field ${unknown}"

    CATALOG=$(jq -r --arg d "${DEFAULT_CATALOG}" '.catalog // $d' <<< "${CONFIG}")
    CATALOG=${CATALOG%/}
    # The owner of the volumes on the host, from the environment as in most images
    PUID=${PUID:-1000} PGID=${PGID:-1000}
    export FITOUT_USER FITOUT_HOME PUID PGID
}

# ---------------------------------------------------------------------------
# Catalog
# ---------------------------------------------------------------------------
# Copies a catalog file: from a URL or, for tests and local catalogs, a path
fetch() {
    case "${CATALOG}" in
        http://* | https://*) curl -fsSL --retry 3 "${CATALOG}/$1" -o "$2" ;;
        *) cp "${CATALOG#file://}/$1" "$2" ;;
    esac
}

# A catalog module, downloaded on every start so the container follows the
# catalog; the cached copy when the catalog is not reachable
catalog_file() {
    local name=$1 file="${CACHE_DIR}/$1.toml"
    mkdir -p "${CACHE_DIR}"
    if fetch "${name}.toml" "${file}.tmp" 2> /dev/null; then
        mv "${file}.tmp" "${file}"
    else
        rm -f "${file}.tmp"
        [ -f "${file}" ] || die "module ${name} is not in the catalog ${CATALOG}, or the catalog is not reachable"
        log "warning: catalog ${CATALOG} not reachable, using the cached ${name}"
    fi
    echo "${file}"
}

# ---------------------------------------------------------------------------
# Modules
# ---------------------------------------------------------------------------
# Fail loud on what this engine does not know, instead of ignoring it
validate_module() {
    local name=$1 file=$2 json problems
    json=$(toml_json "${file}") || die "module ${name}: ${file} is not valid TOML"
    problems=$(jq -r --arg name "${name}" --arg f "${FORMATS}" '
        def unknown($allowed): keys - $allowed;
        [
          (if (.format | tostring | IN($f | split(" ")[])) then empty
           else "uses format \(.format // "none"); this image reads format \($f)" end),
          (if .name == $name then empty else "its name is \(.name // "missing"), not \($name)" end),
          (unknown(["format","name","description","version","tags","author","homepage",
                    "requires","next_steps","env","mise","daemons"])[] | "unknown field \(.)"),
          ((.mise // {}) | unknown(["tools","tasks","bootstrap"])[] | "mise.\(.) is not allowed"),
          ((.mise.bootstrap // {}) | unknown(["packages","hooks"])[] | "mise.bootstrap.\(.) is not allowed"),
          ((.mise.bootstrap.hooks // {}) | unknown(["post-packages","post-tools"])[] | "hook \(.) is not allowed"),
          ((.mise.bootstrap.packages // {}) | keys[] | select(startswith("apt:") | not) | "package \(.) is not an apt package"),
          ((.env // {}) | to_entries[] | .key as $v | .value | (
              (unknown(["type","default","required","choices","protocol","description"])[] | "\($v): unknown field \(.)"),
              (if (.type // "string") | IN("string","secret","port","bool","choice","path") then empty
               else "\($v): unknown type \(.type)" end)))
        ] | .[]' <<< "${json}")
    [ -z "${problems}" ] || die "module ${name} (${SOURCE[${name}]}):"$'\n'"${problems//$'\n'/$'\n'  }"
}

# Resolves a module to its file, recursing into what it requires: a file in
# modules/ of the config folder, otherwise the catalog
add_module() {
    local name=$1 dep version
    [ -z "${FILE[${name}]:-}" ] || return 0
    [[ "${name}" =~ ^[a-z0-9][a-z0-9-]*$ ]] || die "${name} is no module name"
    if [ -f "${CONFIG_DIR}/modules/${name}.toml" ]; then
        FILE[${name}]="${CONFIG_DIR}/modules/${name}.toml"
        SOURCE[${name}]=local
    else
        FILE[${name}]=$(catalog_file "${name}")
        version=$(yq -p toml -o yaml '.version // ""' "${FILE[${name}]}")
        SOURCE[${name}]="catalog${version:+ ${version}}"
    fi
    validate_module "${name}" "${FILE[${name}]}"
    ENABLED+=("${name}")
    for dep in $(yq -p toml -o yaml '(.requires // [])[]' "${FILE[${name}]}"); do
        add_module "${dep}"
    done
}

# Depth-first, so that what a module requires comes before it
visit() {
    local name=$1 dep
    case "${MARK[${name}]:-}" in
        visited) return 0 ;;
        visiting) die "module ${name} requires itself (through a cycle)" ;;
    esac
    MARK[${name}]=visiting
    for dep in $(yq -p toml -o yaml '(.requires // [])[]' "${FILE[${name}]}"); do
        visit "${dep}"
    done
    MARK[${name}]=visited
    ORDER+=("${name}")
}

resolve_modules() {
    local name
    jq -e '(.modules // []) | type == "array" and all(type == "string")' <<< "${CONFIG}" > /dev/null \
        || die "fitout.toml: modules is a list of module names"
    while read -r name; do
        [ -n "${name}" ] && add_module "${name}"
    done < <(jq -r '(.modules // [])[]' <<< "${CONFIG}")
    # deterministic: modules in alphabetical order, then by their dependencies
    while read -r name; do
        [ -n "${name}" ] && visit "${name}"
    done < <(printf '%s\n' "${ENABLED[@]}" | sort)
    [ "${#ORDER[@]}" -gt 0 ] || log "warning: fitout.toml enables no module"
}

# Values: container environment, then [env] of fitout.toml, then the default.
# Secrets only from the environment.
apply_env() {
    local name var type default required configured
    for name in "${ORDER[@]}"; do
        while IFS=$'\x1f' read -r var type default required; do
            [ -n "${var}" ] || continue
            TYPE_OF[${var}]=${type}
            configured=$(jq -r --arg v "${var}" '.env[$v] // empty | tostring' <<< "${CONFIG}")
            if [ "${type}" = secret ] && [ -n "${configured}" ]; then
                die "${var} is a secret of module ${name}: set it in the container environment (.env), not in fitout.toml"
            fi
            if [ -z "${!var:-}" ]; then
                if [ -n "${configured}" ]; then
                    export "${var}=${configured}"
                elif [ -n "${default}" ]; then
                    export "${var}=${default}"
                fi
            fi
            if [ "${required}" = true ] && [ -z "${!var:-}" ]; then
                die "${var} is required by module ${name}"
            fi
            EXPORTED_VARS+=("${var}")
        done < <(yq -p toml -o json '.env // {}' "${FILE[${name}]}" \
            | jq -r 'to_entries[] | [.key, (.value.type // "string"), (.value.default // ""), (.value.required // false | tostring)] | join("\u001f")')
    done
    # [env] entries no module declares still reach the container
    while IFS=$'\x1f' read -r var configured; do
        [ -n "${var}" ] || continue
        [ -n "${TYPE_OF[${var}]:-}" ] && continue
        log "warning: ${var} in fitout.toml is not a variable of any enabled module"
        [ -n "${!var:-}" ] || export "${var}=${configured}"
        EXPORTED_VARS+=("${var}")
    done < <(jq -r '(.env // {}) | to_entries[] | [.key, (.value | tostring)] | join("\u001f")' <<< "${CONFIG}")
}

# [mise] of each module, in setup order: the number keeps their hooks in order
mise_configs() {
    local i=100 name
    for name in "${ORDER[@]}"; do
        if [ "$(yq -p toml -o yaml '.mise // {} | length' "${FILE[${name}]}")" -gt 0 ]; then
            printf '%s\t%s\n' "${i}-${name}.toml" "${name}"
            i=$((i + 1))
        fi
    done
}

mise_config_of() { yq -p toml -o toml '.mise' "${FILE[$1]}"; }

# Tasks of all modules; each becomes a command
tasks() {
    local name task
    declare -A owner=()
    for name in "${ORDER[@]}"; do
        for task in $(yq -p toml -o yaml '(.mise.tasks // {}) | keys | .[]' "${FILE[${name}]}"); do
            [ -z "${owner[${task}]:-}" ] || die "task ${task} is defined by ${owner[${task}]} and ${name}"
            owner[${task}]=${name}
            echo "${task}"
        done
    done
}

# pitchfork config from the [daemons] of all modules, with the image's defaults
pitchfork_config() {
    local name daemon
    declare -A owner=()
    echo "# Generated by fitout on every start from the modules in fitout.toml."
    echo
    echo "[settings.general]"
    echo "# run daemons with the mise tools and environment of all modules"
    echo "mise = true"
    echo
    echo "[settings.supervisor]"
    echo "# the container runs the one supervisor; CLI calls must not start another"
    echo "auto_start = false"
    for name in "${ORDER[@]}"; do
        for daemon in $(yq -p toml -o yaml '(.daemons // {}) | keys | .[]' "${FILE[${name}]}"); do
            [ -z "${owner[${daemon}]:-}" ] || die "daemon ${daemon} is defined by ${owner[${daemon}]} and ${name}"
            owner[${daemon}]=${name}
        done
        [ "$(yq -p toml -o yaml '.daemons // {} | length' "${FILE[${name}]}")" -gt 0 ] || continue
        echo
        echo "# module ${name}"
        WORKSPACE="${WORKSPACE}" yq -p toml -o toml '
            {"daemons": .daemons}
            | with(.daemons[]; select(has("boot_start") | not) | .boot_start = true)
            | with(.daemons[]; select(has("dir") | not) | .dir = strenv(WORKSPACE))
            | with(.daemons[]; select((has("mise") | not) and .user == "root") | .mise = false)
        ' "${FILE[${name}]}"
    done
}

# ---------------------------------------------------------------------------
# Container setup
# ---------------------------------------------------------------------------
setup_user() {
    local existing
    [ "${PUID}" != 0 ] || die "PUID 0 is not supported, the user must not be root"
    if ! getent group "${PGID}" > /dev/null; then
        if getent group "${FITOUT_USER}" > /dev/null; then
            groupmod -g "${PGID}" "${FITOUT_USER}"
        else
            groupadd -g "${PGID}" "${FITOUT_USER}"
        fi
    fi
    existing=$(getent passwd "${PUID}" | cut -d: -f1 || true)
    if [ -n "${existing}" ] && [ "${existing}" != "${FITOUT_USER}" ]; then
        die "UID ${PUID} already belongs to ${existing} in the image, pick another PUID"
    elif id "${FITOUT_USER}" > /dev/null 2>&1; then
        usermod -u "${PUID}" "${FITOUT_USER}"
    else
        useradd -u "${PUID}" -g "${PGID}" -d "${FITOUT_HOME}" -M -s /bin/bash "${FITOUT_USER}"
    fi
    # bash on every start; a module may set another shell in a post-packages
    # hook. '*' unlocks the account for SSH key login without a password.
    usermod -g "${PGID}" -d "${FITOUT_HOME}" -s /bin/bash -p '*' "${FITOUT_USER}"
}

append_block() {
    local file=$1 block=$2
    touch "${file}"
    grep -Fq "${MARKER}" "${file}" || printf '\n%s\n%s\n' "${MARKER}" "${block}" >> "${file}"
    chown "${PUID}:${PGID}" "${file}"
}

# shellcheck disable=SC2016  # the shell blocks expand when a shell reads them
setup_home() {
    local dir
    for dir in "${FITOUT_HOME}" "${FITOUT_HOME}/.config" "${FITOUT_HOME}/.local" \
               "${FITOUT_HOME}/.local/share" "${FITOUT_HOME}/.local/state" "${FITOUT_HOME}/.cache" \
               "${WORKSPACE}"; do
        mkdir -p "${dir}"
        chown "${PUID}:${PGID}" "${dir}"
    done
    # The catalog cache, also written by `fitout plan` as root
    chown -R "${PUID}:${PGID}" "${CACHE_ROOT}" 2>/dev/null || true

    # Interactive shells activate mise. Non-interactive ones (`bash -c`, the
    # shell tools of agents) never reach a prompt, so they load the container
    # and mise environment on every start. Other shells come with modules
    # that set them up the same way.
    local env_line=". ${STATE_DIR}/env 2>/dev/null || true"
    append_block "${FITOUT_HOME}/.bash_env" "${env_line}"$'\n''eval "$(mise env -s bash 2>/dev/null)"'
    append_block "${FITOUT_HOME}/.bashrc" "${env_line}"$'\n''eval "$(mise activate bash)"'
    append_block "${FITOUT_HOME}/.profile" "${env_line}"$'\n''eval "$(mise activate bash --shims)"'
}

# Runtime state for `fitout run`, shells, commands and `docker exec`
write_state() {
    local var task
    rm -rf "${STATE_DIR}"
    mkdir -p "${STATE_DIR}/bin"
    for var in "${EXPORTED_VARS[@]}"; do
        # unset stays unset: an empty CLAUDE_CONFIG_DIR is not the same
        if [ -n "${!var:-}" ]; then
            printf 'export %s=%q\n' "${var}" "${!var}"
        fi
    done > "${STATE_DIR}/env"
    chown "root:${PGID}" "${STATE_DIR}/env"
    chmod 640 "${STATE_DIR}/env"

    ln -s "${FITOUT_HOME}/.local/share/mise/shims" "${STATE_DIR}/shims"
    for task in $(tasks); do
        printf '#!/bin/sh\n# mise task %s of a module\nexec fitout run mise run -q %s -- "$@"\n' \
            "${task}" "${task}" > "${STATE_DIR}/bin/${task}"
        chmod 755 "${STATE_DIR}/bin/${task}"
    done
}

# Copies, not links: mise trusts files in /etc/mise
install_mise_configs() {
    local file name
    rm -rf "${MISE_CONF_D}"
    mkdir -p "${MISE_CONF_D}"
    while IFS=$'\t' read -r file name; do
        [ -n "${file}" ] && mise_config_of "${name}" > "${MISE_CONF_D}/${file}"
    done < <(mise_configs)
}

# Root part (apt packages and their post-packages hooks), then the rest as
# the user (tools and post-tools hooks)
run_bootstrap() {
    local update=()
    if ! HOME=/root mise bootstrap packages status --missing > /dev/null 2>&1; then
        update=(--update)
    fi
    log "Installing packages..."
    DEBIAN_FRONTEND=noninteractive HOME=/root BASH_ENV='' \
        mise bootstrap --only packages --yes "${update[@]}"

    log "Installing tools..."
    as_user mise bootstrap --skip packages --yes
    # Tools at latest (or lts, stable) move on; pin a version to keep one
    log "Upgrading tools..."
    as_user mise upgrade --yes || log "warning: mise upgrade failed, keeping the installed versions"
}

start() {
    [ "$(id -u)" = 0 ] || die "start must run as root"
    read_config
    log "Starting (uid ${PUID}, gid ${PGID}, catalog ${CATALOG})"
    setup_user
    resolve_modules
    log "Modules: $(for n in "${ORDER[@]}"; do printf '%s (%s) ' "${n}" "${SOURCE[${n}]}"; done)"
    export BASH_ENV="${FITOUT_HOME}/.bash_env"
    apply_env
    write_state
    install_mise_configs
    setup_home
    run_bootstrap

    mkdir -p "$(dirname "${PITCHFORK_CONFIG}")"
    pitchfork_config > "${PITCHFORK_CONFIG}"

    log "Starting daemons..."
    cd "${WORKSPACE}"
    SHELL=$(user_shell)
    export HOME="${FITOUT_HOME}" USER="${FITOUT_USER}" LOGNAME="${FITOUT_USER}" SHELL
    exec pitchfork supervisor run --container --boot --invoking-user "${FITOUT_USER}"
}

# ---------------------------------------------------------------------------
# Other commands
# ---------------------------------------------------------------------------
plan() {
    local name var file
    read_config
    resolve_modules
    apply_env
    echo "# Modules in setup order"
    for name in "${ORDER[@]}"; do
        printf '%-16s %s\n' "${name}" "${SOURCE[${name}]}"
    done
    echo
    echo "# Environment"
    for var in "${EXPORTED_VARS[@]}"; do
        if [ "${TYPE_OF[${var}]:-}" = secret ] && [ -n "${!var:-}" ]; then
            printf '%s=***\n' "${var}"
        else
            printf '%s=%s\n' "${var}" "${!var:-}"
        fi
    done
    echo
    echo "# Commands"
    tasks
    while IFS=$'\t' read -r file name; do
        [ -n "${file}" ] || continue
        echo
        echo "# ${MISE_CONF_D}/${file}"
        mise_config_of "${name}"
    done < <(mise_configs)
    echo
    echo "# ${PITCHFORK_CONFIG}"
    pitchfork_config
}

# Healthy once setup has finished and every daemon that starts on boot runs.
# The supervisor only starts after setup, and the CLI must not start one of
# its own when there is none yet.
health() {
    local list down
    PUID=$(id -u "${FITOUT_USER}") PGID=$(id -g "${FITOUT_USER}")
    # pitchfork keeps its socket in the user's home
    list=$(as_user PITCHFORK_SUPERVISOR_AUTO_START=false pitchfork list --json 2> /dev/null) \
        || { echo "pitchfork supervisor is not running yet (setup in progress?)"; exit 1; }
    # available: no boot start; completed: finished one-shot
    down=$(jq -r '.[] | select(.status | IN("running", "available", "disabled", "completed") | not)
        | "\(.name): \(.status) \(.error // "")"' <<< "${list}")
    if [ -n "${down}" ]; then
        echo "${down}"
        exit 1
    fi
}

# As root it switches to the user; `docker compose exec <service> fitout run`
run_as_user() {
    # shellcheck source=/dev/null
    . "${STATE_DIR}/env" 2>/dev/null || die "setup has not finished yet"
    if [ "$(id -u)" = 0 ]; then
        exec gosu "${PUID}:${PGID}" env \
            HOME="${FITOUT_HOME}" USER="${FITOUT_USER}" LOGNAME="${FITOUT_USER}" SHELL="$(user_shell)" \
            "$0" run "$@"
    fi
    [ $# -gt 0 ] || set -- "$(user_shell)" -l
    exec mise exec -- "$@"
}

case "${1:-start}" in
    start) start ;;
    run) shift; run_as_user "$@" ;;
    plan) plan ;;
    health) health ;;
    *) die "unknown command '$1' (start, run, plan, health)" ;;
esac
