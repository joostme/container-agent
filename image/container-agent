#!/bin/bash
# Sets up the agent user and the enabled modules, then hands over to
# pitchfork, which runs the daemons of the modules.
#
#   container-agent start     entrypoint, runs as root
#   container-agent plan      print the resolved modules and generated config
#   container-agent modules   list the available modules
#   container-agent health    healthcheck: no daemon has failed
set -euo pipefail

AGENT_USER=${AGENT_USER:-agent}
PUID=${PUID:-1000}
PGID=${PGID:-1000}
AGENT_HOME=${AGENT_HOME:-/home/${AGENT_USER}}
AGENT_WORKSPACE=${AGENT_WORKSPACE:-/repos}
AGENT_MODULES=${AGENT_MODULES:-}
AUTO_UPDATE=${AUTO_UPDATE:-true}
# Modules earlier in the path win, so a user module replaces a built-in one
MODULE_PATH=${CONTAINER_AGENT_MODULE_PATH:-${AGENT_HOME}/.config/container-agent/modules:/etc/container-agent/modules}
STATE_DIR=/run/container-agent
MISE_CONF_D=/etc/mise/conf.d
PITCHFORK_CONFIG=/etc/pitchfork/config.toml
MARKER="# container-agent mise setup"

export AGENT_USER PUID PGID AGENT_HOME AGENT_WORKSPACE

declare -A MODULE_DIRS=() MARK=()
ENABLED=()
ORDER=()
EXPORTED_VARS=(AGENT_USER PUID PGID AGENT_HOME AGENT_WORKSPACE BASH_ENV)

log() { echo "[container-agent] $*"; }
die() { echo "[container-agent] error: $*" >&2; exit 1; }

as_agent() {
    (cd "${AGENT_HOME}" && gosu "${PUID}:${PGID}" env \
        HOME="${AGENT_HOME}" USER="${AGENT_USER}" LOGNAME="${AGENT_USER}" SHELL=/bin/zsh \
        "$@")
}

# ---------------------------------------------------------------------------
# Modules
# ---------------------------------------------------------------------------
find_module() {
    local dir IFS=:
    for dir in ${MODULE_PATH}; do
        if [ -f "${dir}/$1/module.toml" ]; then
            echo "${dir}/$1"
            return 0
        fi
    done
    return 1
}

# Items of a list in module.toml, one per line
module_list() {
    yq -p toml -o yaml "(.$2 // [])[]" "$1/module.toml"
}

add_module() {
    local name=$1 dir dep
    [ -n "${MODULE_DIRS[${name}]:-}" ] && return 0
    dir=$(find_module "${name}") || die "unknown module '${name}' (searched ${MODULE_PATH})"
    MODULE_DIRS[${name}]=${dir}
    ENABLED+=("${name}")
    for dep in $(module_list "${dir}" requires); do
        add_module "${dep}"
    done
}

# Depth-first, so that requires and after come before the module itself
visit() {
    local name=$1 dep
    case "${MARK[${name}]:-}" in
        visited) return 0 ;;
        visiting) die "module '${name}' depends on itself (requires/after cycle)" ;;
    esac
    MARK[${name}]=visiting
    for dep in $(module_list "${MODULE_DIRS[${name}]}" requires) \
               $(module_list "${MODULE_DIRS[${name}]}" after); do
        if [ -n "${MODULE_DIRS[${dep}]:-}" ]; then
            visit "${dep}"
        fi
    done
    MARK[${name}]=visited
    ORDER+=("${name}")
}

resolve_modules() {
    local name
    for name in ${AGENT_MODULES//,/ }; do
        add_module "${name}"
    done
    for name in "${ENABLED[@]}"; do
        visit "${name}"
    done
    [ "${#ORDER[@]}" -gt 0 ] || log "warning: AGENT_MODULES is empty, no module enabled"
}

check_arch() {
    local arch name supported
    arch=$(dpkg --print-architecture 2>/dev/null || uname -m)
    for name in "${ORDER[@]}"; do
        supported=$(module_list "${MODULE_DIRS[${name}]}" arch)
        if [ -n "${supported}" ] && ! grep -qx "${arch}" <<< "${supported}"; then
            die "module '${name}' does not support ${arch}"
        fi
    done
}

# Set the defaults of module variables that the container environment leaves
# empty, and stop on required variables without a value
apply_env_defaults() {
    local name var default required
    for name in "${ORDER[@]}"; do
        # \x1f, not a tab: read merges runs of whitespace separators, so an
        # empty default would shift the columns
        while IFS=$'\x1f' read -r var default required; do
            [ -n "${var}" ] || continue
            if [ -z "${!var:-}" ] && [ -n "${default}" ]; then
                export "${var}=${default}"
            fi
            if [ "${required}" = true ] && [ -z "${!var:-}" ]; then
                die "${var} is required by module '${name}'"
            fi
            EXPORTED_VARS+=("${var}")
        done < <(yq -p toml -o json '.env // {}' "${MODULE_DIRS[${name}]}/module.toml" \
            | jq -r 'to_entries[] | [.key, (.value.default // ""), (.value.required // false | tostring)] | join("\u001f")')
    done
}

# pitchfork config from the [daemons] of all enabled modules. Daemons start on
# boot and in the workspace unless the module says otherwise.
pitchfork_config() {
    local name file
    echo "# Generated by container-agent on every start. Change the modules instead."
    echo "# Your own daemons go into ~/.config/pitchfork/config.toml."
    echo
    echo "[settings.general]"
    echo "# run daemons with the mise tools and environment of the agent user"
    echo "mise = true"
    echo
    echo "[settings.supervisor]"
    echo "# the container runs the one supervisor; CLI calls must not start another"
    echo "auto_start = false"
    for name in "${ORDER[@]}"; do
        file=${MODULE_DIRS[${name}]}/module.toml
        [ "$(yq -p toml -o yaml '.daemons // {} | length' "${file}")" -gt 0 ] || continue
        echo
        echo "# module ${name}"
        WORKSPACE="${AGENT_WORKSPACE}" yq -p toml -o toml '
            {"daemons": .daemons}
            | with(.daemons[]; select(has("boot_start") | not) | .boot_start = true)
            | with(.daemons[]; select(has("dir") | not) | .dir = strenv(WORKSPACE))
        ' "${file}"
    done
}

# ---------------------------------------------------------------------------
# Container setup
# ---------------------------------------------------------------------------
setup_user() {
    local existing
    [ "${PUID}" != 0 ] || die "PUID=0 is not supported, the agent must not run as root"

    if getent group "${PGID}" > /dev/null; then
        :
    elif getent group "${AGENT_USER}" > /dev/null; then
        groupmod -g "${PGID}" "${AGENT_USER}"
    else
        groupadd -g "${PGID}" "${AGENT_USER}"
    fi

    existing=$(getent passwd "${PUID}" | cut -d: -f1 || true)
    if [ -n "${existing}" ] && [ "${existing}" != "${AGENT_USER}" ]; then
        die "UID ${PUID} already belongs to '${existing}' in the image, pick another PUID"
    elif id "${AGENT_USER}" > /dev/null 2>&1; then
        usermod -u "${PUID}" "${AGENT_USER}"
    else
        useradd -u "${PUID}" -g "${PGID}" -d "${AGENT_HOME}" -M -s /bin/zsh "${AGENT_USER}"
    fi
    # '*' unlocks the account for SSH key login without allowing a password
    usermod -g "${PGID}" -d "${AGENT_HOME}" -s /bin/zsh -p '*' "${AGENT_USER}"
}

append_block() {
    local file=$1 block=$2
    touch "${file}"
    grep -Fq "${MARKER}" "${file}" || printf '\n%s\n%s\n' "${MARKER}" "${block}" >> "${file}"
    chown "${PUID}:${PGID}" "${file}"
}

# shellcheck disable=SC2016  # the shell blocks expand when a shell reads them
setup_home() {
    local dir
    for dir in "${AGENT_HOME}" "${AGENT_HOME}/.config" "${AGENT_HOME}/.local" \
               "${AGENT_HOME}/.local/share" "${AGENT_HOME}/.local/state" "${AGENT_HOME}/.cache" \
               "${AGENT_WORKSPACE}"; do
        mkdir -p "${dir}"
        chown "${PUID}:${PGID}" "${dir}"
    done
    # Files root left behind in earlier runs would break installs as the user.
    # Only root-owned ones: bind mounts from the host keep their owner.
    find "${AGENT_HOME}" -path "${AGENT_HOME}/.ssh-keys" -prune -o -user 0 -print0 \
        | xargs -0r chown -h "${PUID}:${PGID}"

    # SSH keys mounted read-only at ~/.ssh-keys
    mkdir -p "${AGENT_HOME}/.ssh"
    if [ -d "${AGENT_HOME}/.ssh-keys" ]; then
        cp -a "${AGENT_HOME}/.ssh-keys/." "${AGENT_HOME}/.ssh/"
    fi
    [ -f "${AGENT_HOME}/.ssh/config" ] \
        || printf 'Host *\n    StrictHostKeyChecking accept-new\n' > "${AGENT_HOME}/.ssh/config"
    chown -R "${PUID}:${PGID}" "${AGENT_HOME}/.ssh"
    chmod 700 "${AGENT_HOME}/.ssh"
    chmod 600 "${AGENT_HOME}/.ssh/config" "${AGENT_HOME}/.ssh/authorized_keys" \
        "${AGENT_HOME}/.ssh/id_"* 2>/dev/null || true

    # Single-purpose container: trust every repository
    as_agent git config --global --get-all safe.directory 2>/dev/null | grep -Fxq '*' \
        || as_agent git config --global --add safe.directory '*'

    # Interactive shells activate mise. Non-interactive ones (the shell tools of
    # agents, `bash -c`) never reach a prompt, so they load the container and
    # mise environment on every start; this also picks up mise config changes.
    local env_line=". ${STATE_DIR}/env 2>/dev/null || true"
    append_block "${AGENT_HOME}/.zshenv" "${env_line}"$'\n''eval "$(mise env -s zsh 2>/dev/null)"'
    append_block "${AGENT_HOME}/.bash_env" "${env_line}"$'\n''eval "$(mise env -s bash 2>/dev/null)"'
    append_block "${AGENT_HOME}/.zshrc" 'eval "$(mise activate zsh)"'
    append_block "${AGENT_HOME}/.bashrc" "${env_line}"$'\n''eval "$(mise activate bash)"'
    append_block "${AGENT_HOME}/.profile" "${env_line}"$'\n''eval "$(mise activate bash --shims)"'
}

# Runtime state for agent-run, shells and `docker exec`
write_state() {
    local name var file
    rm -rf "${STATE_DIR}"
    mkdir -p "${STATE_DIR}/bin"
    for var in "${EXPORTED_VARS[@]}"; do
        # unset stays unset: an empty CLAUDE_CONFIG_DIR is not the same
        if [ -n "${!var:-}" ]; then
            printf 'export %s=%q\n' "${var}" "${!var}"
        fi
    done > "${STATE_DIR}/env"
    chown "root:${PGID}" "${STATE_DIR}/env"
    chmod 640 "${STATE_DIR}/env"

    ln -s "${AGENT_HOME}/.local/share/mise/shims" "${STATE_DIR}/shims"
    for name in "${ORDER[@]}"; do
        for file in "${MODULE_DIRS[${name}]}/bin/"*; do
            [ -f "${file}" ] && ln -sf "${file}" "${STATE_DIR}/bin/"
        done
    done
}

# Copies, not links: mise trusts files in /etc/mise, but would ask about
# links that point into the home directory. The number keeps the order of
# their bootstrap hooks.
install_mise_configs() {
    local i=100 name
    rm -rf "${MISE_CONF_D}"
    mkdir -p "${MISE_CONF_D}"
    for name in "${ORDER[@]}"; do
        if [ -f "${MODULE_DIRS[${name}]}/mise.toml" ]; then
            cp "${MODULE_DIRS[${name}]}/mise.toml" "${MISE_CONF_D}/${i}-${name}.toml"
            i=$((i + 1))
        fi
    done
}

# Root part (apt packages and their post-packages hooks), then the rest as
# the agent user (tools and the post-tools/final hooks). Root reads the
# user's mise config too, so packages declared there get installed.
run_bootstrap() {
    local update=() user_config="${AGENT_HOME}/.config/mise"
    if ! MISE_CONFIG_DIR="${user_config}" mise bootstrap packages status --missing > /dev/null 2>&1; then
        update=(--update)
    fi
    log "Installing packages..."
    DEBIAN_FRONTEND=noninteractive MISE_CONFIG_DIR="${user_config}" HOME=/root BASH_ENV='' \
        mise bootstrap --only packages --yes "${update[@]}"

    log "Installing tools..."
    as_agent mise bootstrap --skip packages --yes
    if [ "${AUTO_UPDATE}" = true ]; then
        log "Upgrading tools..."
        as_agent mise upgrade --yes || log "warning: mise upgrade failed, keeping the installed versions"
    fi
}

start() {
    [ "$(id -u)" = 0 ] || die "start must run as root"
    log "Starting (user ${AGENT_USER}, uid ${PUID}, gid ${PGID})"
    setup_user
    resolve_modules
    check_arch
    log "Modules: ${ORDER[*]:-none}"
    export BASH_ENV="${AGENT_HOME}/.bash_env"
    apply_env_defaults
    write_state
    install_mise_configs
    setup_home
    run_bootstrap

    mkdir -p "$(dirname "${PITCHFORK_CONFIG}")"
    pitchfork_config > "${PITCHFORK_CONFIG}"

    log "Starting daemons..."
    cd "${AGENT_WORKSPACE}"
    export HOME="${AGENT_HOME}" USER="${AGENT_USER}" LOGNAME="${AGENT_USER}" SHELL=/bin/zsh
    exec pitchfork supervisor run --container --boot --invoking-user "${AGENT_USER}"
}

# ---------------------------------------------------------------------------
# Other commands
# ---------------------------------------------------------------------------
plan() {
    local name var
    resolve_modules
    apply_env_defaults
    echo "# Modules in setup order"
    for name in "${ORDER[@]}"; do
        printf '%-16s %s\n' "${name}" "${MODULE_DIRS[${name}]}"
    done
    echo
    echo "# Environment"
    for var in "${EXPORTED_VARS[@]}"; do
        printf '%s=%s\n' "${var}" "${!var:-}"
    done
    echo
    echo "# ${PITCHFORK_CONFIG}"
    pitchfork_config
}

modules() {
    local dir file name IFS=:
    declare -A seen=()
    for dir in ${MODULE_PATH}; do
        for file in "${dir}"/*/module.toml; do
            [ -f "${file}" ] || continue
            name=$(basename "$(dirname "${file}")")
            [ -z "${seen[${name}]:-}" ] || continue
            seen[${name}]=1
            printf '%-16s %s\n' "${name}" "$(yq -p toml -o yaml '.description' "${file}")"
        done
    done | sort
}

health() {
    local failed
    # pitchfork keeps its socket in the agent user's home
    failed=$(as_agent pitchfork list --hide-header --status errored --status failed) \
        || { echo "pitchfork supervisor not reachable"; exit 1; }
    if [ -n "${failed}" ]; then
        echo "${failed}"
        exit 1
    fi
}

case "${1:-start}" in
    start) start ;;
    plan) plan ;;
    modules) modules ;;
    health) health ;;
    *) die "unknown command '$1' (start, plan, modules, health)" ;;
esac
