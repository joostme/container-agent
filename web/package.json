{
	"name": "container-agent-configurator",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "npm run prepare-data && vite dev",
		"build": "npm run prepare-data && vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "npm run prepare-data && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test": "npm run prepare-data && vitest --run",
		"prepare-data": "node scripts/prepare.js"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/node": "^26.6.6",
		"fflate": "^0.8.3",
		"jsdom": "^30.1.3",
		"smol-toml": "^1.9.1",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0",
		"vitest": "^4.1.8",
		"yaml": "^2.9.1"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"description": "Static configurator that turns catalog and custom modules into agent.toml and compose.yaml"
}
