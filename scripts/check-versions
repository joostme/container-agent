#!/bin/bash
# The module schema links the mise and pitchfork schemas of the versions the
# image pins; the links and the Dockerfile must name the same versions.
set -euo pipefail
cd "$(dirname "$0")/.."

schema=schema/v1/module.schema.json
failed=0
for tool in mise pitchfork; do
    var=$(tr '[:lower:]' '[:upper:]' <<< "${tool}")_VERSION
    image=$(sed -n "s/^ARG ${var}=//p" Dockerfile)
    linked=$(grep -o "jdx/${tool}/v[0-9.]*/" "${schema}" | sed "s|jdx/${tool}/v||; s|/$||" | sort -u)
    if [ "${image}" != "${linked}" ]; then
        echo "${tool} ${image} in the Dockerfile, but ${schema} links ${linked:-none}" >&2
        failed=1
    fi
done
exit "${failed}"
