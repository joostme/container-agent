#!/bin/bash
# Rules for catalog modules beyond the schema (mise run lint checks that):
#
# - the name equals the file name, `version` is semver
# - variables start with the module name (`t3` -> `T3_`), or `MISE_` plus
#   it for variables mise reads itself (`MISE_NODE_VERSION`); tasks and
#   daemons are the module name or start with it and a dash
# - no variable, task or daemon is defined by two modules
# - `requires` names catalog modules
#
#   scripts/check-catalog
set -euo pipefail
cd "$(dirname "$0")/.."

modules=$(for file in catalog/*.toml; do
    yq -p toml -o json '.' "${file}" | jq --arg file "$(basename "${file}" .toml)" '{file: $file, module: .}'
done | jq -s '.')

problems=$(jq -r '
    (map(.file)) as $names
    | (map(.module | {name, keys: ((.env // {} | keys | map("variable " + .))
        + (.mise.tasks // {} | keys | map("task " + .))
        + (.daemons // {} | keys | map("daemon " + .)))})) as $defs
    | (.[] | .file as $file | .module as $m
        | ($file | ascii_upcase | gsub("-"; "_")) as $prefix
        | (if $m.name == $file then empty else "\($file): name is \($m.name)" end),
          (if ($m.version // "" | test("^[0-9]+\\.[0-9]+\\.[0-9]+$")) then empty
           else "\($file): version \($m.version // "missing") is not x.y.z" end),
          ($m.env // {} | keys[]
            | select((startswith($prefix + "_") or startswith("MISE_" + $prefix + "_")) | not)
            | "\($file): variable \(.) does not start with \($prefix)_"),
          ((($m.mise.tasks // {}) + ($m.daemons // {})) | keys[]
            | select(. != $file and (startswith($file + "-") | not))
            | "\($file): task or daemon \(.) does not start with \($file)-"),
          (($m.requires // [])[]
            | select(IN($names[]) | not) | "\($file): \(.) is not in the catalog")),
      ($defs | map(.name as $n | .keys[] | {key: ., name: $n}) | group_by(.key)[]
        | select(length > 1) | "\(.[0].key) is defined by \(map(.name) | join(" and "))")
' <<< "${modules}")


problems=$(sed '/^$/d' <<< "${problems}")
if [ -n "${problems}" ]; then
    echo "${problems}" >&2
    exit 1
fi
echo "catalog: $(jq length <<< "${modules}") modules ok"
